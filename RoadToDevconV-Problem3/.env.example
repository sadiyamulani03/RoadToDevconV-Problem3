# Copy to .env (never commit .env). All values are secrets or local endpoints.
# Public identities live in config/example-config.json — not here.

# Bee node HTTP API (keep on localhost; never expose the Bee API to the internet)
BEE_URL=http://localhost:1633
# Bee debug API (used by storage:inspect for batch listing)
BEE_DEBUG_URL=http://localhost:1635

# Postage batch id used for uploads / feed updates (64 lowercase hex chars)
BATCH_ID=

# Role private keys (64 hex chars, no 0x prefix needed; 0x tolerated).
# Each role MUST be a different key. Generate with: npm run identities:generate
FUNDING_PRIVATE_KEY=
PUBLISHER_PRIVATE_KEY=
SUCCESSION_AUTHORITY_PRIVATE_KEY=

# Feed topics (public strings; defaults are safe to keep)
ROOT_FEED_TOPIC=monastery-catalogue-root-v1
PUBLISHER_FEED_TOPIC=monastery-catalogue-pub-v1

# Incoming steward supplied EXTERNALLY at hand-off time (address and/or key).
# The succession code never hardcodes these — pass via CLI flag or env.
INCOMING_PUBLISHER_ADDRESS=
INCOMING_PUBLISHER_PRIVATE_KEY=

# Local catalogue file to publish
CATALOGUE_PATH=./data/seed-catalogue.json
# Public config file (default tracks only public identities)
CONFIG_PATH=./config/example-config.json
